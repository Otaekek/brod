fn pow(a,b) {
	var i = 0;
	var ret = 1;
	while (i < b)
	{
		ret = ret * a; i = i + 1;
	}
	ret;
};

print(pow(2, 3) == 8);

class a {
	fn a() {
		return 1;
	}

	var b;
}

fn fibonacci(a) {
	if (a < 2) {
		a;
	} else {
		fibonacci(a - 1) + fibonacci(a - 2);
	}
}

print(fibonacci(7) == 13);

fn modulo(n, m) {
	while (n >= m) {
		var d = m;
		var next = d + d;
		while (next <= n) {
			d = next;
			next = d + d;
		}
		n = n - d;
	}
	return n;
}

fn gcd(a, b) {
	if (b == 0) return a;
	return gcd(b, modulo(a, b));
}

print(gcd(48, 18) == 6);
print(gcd(17, 5) == 1);
print(gcd(0, 5) == 5);

fn fizzbuzz(n) {
	if (modulo(n, 15) == 0) return "FizzBuzz";
	if (modulo(n, 3) == 0) return "Fizz";
	if (modulo(n, 5) == 0) return "Buzz";
	return "" + n;
}

print(fizzbuzz(3) == "Fizz");
print(fizzbuzz(5) == "Buzz");
print(fizzbuzz(15) == "FizzBuzz");
print(fizzbuzz(7) == "7");

fn is_prime(n) {
	if (n < 2) return false;
	if (n < 4) return true;
	if (modulo(n, 2) == 0) return false;
	var i = 3;
	while (i * i <= n) {
		if (modulo(n, i) == 0) return false;
		i = i + 2;
	}
	return true;
}

print(is_prime(2) == true);
print(is_prime(17) == true);
print(is_prime(1) == false);
print(is_prime(100) == false);
print(is_prime(97) == true);

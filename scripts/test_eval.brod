print(2 + 3 * 4 != 20);
print((2 + 3) * 4 == 20);
var a = "global a";
{
	var a = "outer a";
	{
		var a = "inner a";
		print(a == "inner a");
	}
	print(a == "outer a");
}
print(a == "global a");

var b = 2;

while (b < 64) {
	b = b * 2; 
}

print(b == 64);
print(abs(-1) == 1);
print(sin(3.1415 / 2.0) <= 1.0);
fn pow(a,b) {
	var i = 0;
	var ret = 1;
	while (i < b)
	{
		ret = ret * a; i = i + 1;
	}
	ret;
};

print(pow(2, 3) == 8);

class a {
	fn a() {
		return 1;
	}

	var b;
}

fn fibonacci(a) {
	if (a < 2) {
		a;
	} else {
		fibonacci(a - 1) + fibonacci(a - 2);
	}
}

print(fibonacci(7) == 13);

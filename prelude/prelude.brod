// brod prelude - loaded automatically before every script/session.
// Disable with --no-prelude.

fn min(a, b) {
	if (a < b) {
		return a;
	}
	return b;
}

fn max(a, b) {
	if (a > b) {
		return a;
	}
	return b;
}

fn clamp(x, lo, hi) {
	return max(lo, min(x, hi));
}

fn modulo(n, m) {
	while (n >= m) {
		var d = m;
		var next = d + d;
		while (next <= n) {
			d = next;
			next = d + d;
		}
		n = n - d;
	}
	return n;
}

fn pow(base, exponent) {
	var result = 1;
	var i = 0;
	while (i < exponent) {
		result = result * base;
		i = i + 1;
	}
	return result;
}

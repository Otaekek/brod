// Math and arithmetic
// Everything printed should evaluate to true

print(1 + 1 == 2);
print(5 - 3 == 2);
print(4 * 3 == 12);
print(10 / 2 == 5);
print(2 + 3 * 4 == 14);
print((2 + 3) * 4 == 20);
print(-5 + 10 == 5);
print(-(3 + 2) == -5);

// Operator precedence
print(1 + 2 * 3 - 4 / 2 == 5);

// Float arithmetic
print(1.5 + 1.5 == 3.0);
print(0.1 + 0.2 <= 0.30000001);

// Foreign math functions
print(abs(-1) == 1);
print(abs(1) == 1);
print(sin(0) == 0);
print(cos(0) == 1);
print(sin(3.1415 / 2.0) <= 1.0);

// A couple of helper functions built from primitives
fn modulo(n, m) {
	while (n >= m) {
		var d = m;
		var next = d + d;
		while (next <= n) {
			d = next;
			next = d + d;
		}
		n = n - d;
	}
	return n;
}

print(modulo(10, 3) == 1);
print(modulo(9, 3) == 0);

fn gcd(a, b) {
	if (b == 0) return a;
	return gcd(b, modulo(a, b));
}

print(gcd(48, 18) == 6);
print(gcd(17, 5) == 1);
